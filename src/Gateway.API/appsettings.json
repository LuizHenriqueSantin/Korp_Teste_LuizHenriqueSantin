{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Yarp": "Information"
      }
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "estoque-route": {
        "ClusterId": "estoque-cluster",
        "Match": {
          "Path": "/api/estoque/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/estoque" }
        ]
      },
      "faturamento-route": {
        "ClusterId": "faturamento-cluster",
        "Match": {
          "Path": "/api/faturamento/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/faturamento" }
        ]
      }
    },
    "Clusters": {
      "estoque-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5101/"
          }
        }
      },
      "faturamento-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5201/"
          }
        }
      }
    }
  }
}
